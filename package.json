{
  "name": "remember-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first, open-source search and retrieval engine for people and agents",
  "scripts": {
    "dev": "pnpm --filter @useremember/core dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "license": "MIT"
}
