{
  "name": "@useremember/core",
  "version": "0.3.0",
  "description": "Headless retrieval engine for remember — indexing, hybrid search, ranking, HTTP API, and CLI.",
  "license": "MIT",
  "keywords": [
    "wiki",
    "search",
    "retrieval",
    "rag",
    "hybrid-search",
    "bm25",
    "vector-search",
    "embeddings",
    "ai-tools",
    "markdown"
  ],
  "homepage": "https://github.com/aakusch/remember#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aakusch/remember.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/aakusch/remember/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embedders/local-onnx": "./dist/embedders/local-onnx.js",
    "./embedders/openai": "./dist/embedders/openai.js",
    "./chunkers/smart-split": "./dist/chunkers/smart-split.js",
    "./walkers/chokidar": "./dist/walkers/chokidar.js",
    "./parsers/remark": "./dist/parsers/remark.js",
    "./stores/sqlite-vec": "./dist/stores/sqlite-vec.js",
    "./search/hybrid": "./dist/search/hybrid.js",
    "./search/evidence": "./dist/search/evidence.js",
    "./evaluation": "./dist/evaluation/index.js",
    "./query-planners/passthrough": "./dist/query-planners/passthrough.js",
    "./rerankers/none": "./dist/rerankers/none.js"
  },
  "bin": {
    "remember": "bin/remember.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "dev": "tsx watch src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "node --import tsx src/cli/benchmark.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo '(eslint not yet configured)'"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@hono/node-server": "^2.0.12",
    "better-sqlite3": "^11.3.0",
    "chokidar": "^4.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.32",
    "ignore": "^6.0.2",
    "jiti": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "sqlite-vec": "^0.1.4",
    "unified": "^11.0.5",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
