---
import Layout from '../../../layouts/Layout.astro';
import { getPageRaw, savePage, listPageHistory } from '../../../lib/api.ts';

const slug = Astro.params.slug ?? '';
const targetPath = slug.endsWith('.md') ? slug : `${slug}.md`;

const history = await listPageHistory(targetPath, 8);
const fmtAge = (iso: string) => {
  const ms = Date.now() - new Date(iso).getTime();
  if (ms < 60_000) return `${Math.floor(ms / 1000)}s ago`;
  if (ms < 3_600_000) return `${Math.floor(ms / 60_000)}m ago`;
  if (ms < 86_400_000) return `${Math.floor(ms / 3_600_000)}h ago`;
  return new Date(iso).toISOString().slice(0, 10);
};
const fmtSize = (n: number) => (n < 1024 ? `${n} B` : `${(n / 1024).toFixed(1)} KB`);

let saveError: string | null = null;
let saved = false;
let savedChunks = 0;

let currentBody = (await getPageRaw(targetPath)) ?? '';
let editedBody = currentBody;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  editedBody = String(form.get('body') ?? currentBody);
  const action = String(form.get('action') ?? 'save');

  if (action === 'save') {
    const r = await savePage(targetPath, editedBody);
    if (r.ok) {
      saved = true;
      savedChunks = r.indexed ?? 0;
      currentBody = editedBody;
    } else {
      saveError = r.error?.message ?? 'Unknown error';
    }
  }
}

const isNewFile = currentBody === '' && !saved;
---
<Layout title={`Edit: ${targetPath}`} currentPath={targetPath}>
  <div class="main-col">
    <h1 style="margin-bottom: 0.25rem;">{isNewFile ? 'New page' : 'Edit page'}</h1>
    <p class="muted" style="margin: 0 0 1rem 0;">
      <code>{targetPath}</code>
    </p>

    {saved && (
      <div class="alert success">
        <strong>Saved.</strong> Re-indexed: {savedChunks} chunk{savedChunks === 1 ? '' : 's'}.
        <a href={`/${targetPath.replace(/\.md$/, '')}`} style="margin-left: 0.5rem;">View page →</a>
      </div>
    )}

    {saveError && (
      <div class="alert error">
        <strong>Save failed:</strong> {saveError}
      </div>
    )}

    <form method="post" class="editor-form">
      <div class="editor-grid">
        <div class="editor-pane">
          <div class="pane-label-row">
            <label class="pane-label" for="body-input">Markdown source · type <kbd>/</kbd> for commands · <kbd>Cmd/Ctrl+S</kbd> to save</label>
            <span id="editor-status" class="editor-status" data-state="clean">Saved</span>
          </div>
          <div class="editor-toolbar" role="toolbar" aria-label="Formatting">
            <button type="button" class="tb-btn" data-action="wrap" data-pre="**" data-post="**" title="Bold (Cmd/Ctrl+B)" aria-label="Bold">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>
            </button>
            <button type="button" class="tb-btn" data-action="wrap" data-pre="*" data-post="*" title="Italic (Cmd/Ctrl+I)" aria-label="Italic">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/></svg>
            </button>
            <button type="button" class="tb-btn" data-action="wrap" data-pre="`" data-post="`" title="Inline code" aria-label="Inline code">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </button>
            <span class="tb-divider" aria-hidden="true"></span>
            <button type="button" class="tb-btn tb-btn-text" data-action="linestart" data-prefix="# " title="Heading 1">H1</button>
            <button type="button" class="tb-btn tb-btn-text" data-action="linestart" data-prefix="## " title="Heading 2">H2</button>
            <button type="button" class="tb-btn tb-btn-text" data-action="linestart" data-prefix="### " title="Heading 3">H3</button>
            <span class="tb-divider" aria-hidden="true"></span>
            <button type="button" class="tb-btn" data-action="linestart" data-prefix="- " title="Bullet list" aria-label="Bullet list">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            </button>
            <button type="button" class="tb-btn" data-action="linestart" data-prefix="1. " title="Numbered list" aria-label="Numbered list">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" y1="6" x2="21" y2="6"/><line x1="10" y1="12" x2="21" y2="12"/><line x1="10" y1="18" x2="21" y2="18"/><path d="M4 6h1v4"/><path d="M4 10h2"/><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"/></svg>
            </button>
            <button type="button" class="tb-btn" data-action="linestart" data-prefix="> " title="Quote" aria-label="Quote">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2H4c-1.25 0-2 .75-2 2v6c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2v4z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2h-4c-1.25 0-2 .75-2 2v6c0 1.25.75 2 2 2h.5c.5 0 .5 0 .5 1v1c0 1-1 2-2 2v4z"/></svg>
            </button>
            <span class="tb-divider" aria-hidden="true"></span>
            <button type="button" class="tb-btn" data-action="link" title="Link (Cmd/Ctrl+K)" aria-label="Link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </button>
            <button type="button" class="tb-btn" data-action="codeblock" title="Code block" aria-label="Code block">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><polyline points="8 9 5 12 8 15"/><polyline points="16 9 19 12 16 15"/></svg>
            </button>
          </div>
          <textarea id="body-input" name="body" spellcheck="false">{editedBody}</textarea>
          <div id="slash-menu" class="slash-menu" hidden></div>
        </div>
        <div class="editor-pane">
          <span class="pane-label">Preview</span>
          <div id="preview" class="preview-pane"></div>
        </div>
      </div>

      <div class="editor-actions">
        <button type="submit" name="action" value="save" class="btn">Save</button>
        <a href={`/${targetPath.replace(/\.md$/, '')}`} class="btn secondary">Cancel</a>
        <span class="muted" style="margin-left: 0.5rem; font-size: 0.85rem;">
          Files are written to disk and reindexed immediately. Git stays hands-off — commit when you're satisfied.
        </span>
      </div>
    </form>

    {history.length > 0 && (
      <section class="history-panel">
        <div class="history-header">
          <h3>History</h3>
          <span class="muted">last {history.length} save{history.length === 1 ? '' : 's'}</span>
        </div>
        <ul class="history-list">
          {history.map((h) => (
            <li>
              <a href={`/admin/history?path=${encodeURIComponent(targetPath)}&id=${h.id}`}>
                <span class="hist-age">{fmtAge(h.written_at)}</span>
                <span class="muted hist-size">{fmtSize(h.byte_size)}</span>
                <span class="muted hist-sha">{h.sha256.slice(0, 7)}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="muted history-hint">
          A snapshot is taken just before every save. Snapshots are stored in <code>.remember/index.db</code>.
        </p>
      </section>
    )}
  </div>
</Layout>

<script>
  import { marked } from 'marked';
  const textarea = document.getElementById('body-input') as HTMLTextAreaElement;
  const preview = document.getElementById('preview') as HTMLDivElement;
  const slashMenu = document.getElementById('slash-menu') as HTMLDivElement;

  type SlashCommand = {
    keyword: string;
    label: string;
    hint: string;
    insert: string;
    /** Caret offset from the end of the inserted text. Negative = move left from end. */
    caretOffset?: number;
  };

  const COMMANDS: SlashCommand[] = [
    { keyword: 'h1',     label: 'Heading 1',       hint: '# Title',                   insert: '# ' },
    { keyword: 'h2',     label: 'Heading 2',       hint: '## Section',                insert: '## ' },
    { keyword: 'h3',     label: 'Heading 3',       hint: '### Subsection',            insert: '### ' },
    { keyword: 'h4',     label: 'Heading 4',       hint: '#### ',                     insert: '#### ' },
    { keyword: 'bullet', label: 'Bullet list',     hint: '- item',                    insert: '- ' },
    { keyword: 'numbered', label: 'Numbered list', hint: '1. item',                   insert: '1. ' },
    { keyword: 'todo',   label: 'Task list',       hint: '- [ ] todo',                insert: '- [ ] ' },
    { keyword: 'code',   label: 'Code block',      hint: '```lang\\n…\\n```',           insert: '```\n\n```\n', caretOffset: -5 },
    { keyword: 'code-ts', label: 'TypeScript block', hint: '```ts',                   insert: '```ts\n\n```\n', caretOffset: -5 },
    { keyword: 'code-py', label: 'Python block',   hint: '```py',                     insert: '```python\n\n```\n', caretOffset: -5 },
    { keyword: 'code-sh', label: 'Shell block',    hint: '```bash',                   insert: '```bash\n\n```\n', caretOffset: -5 },
    { keyword: 'quote',  label: 'Block quote',     hint: '> quote',                   insert: '> ' },
    { keyword: 'table',  label: 'Table',           hint: '| a | b |',                 insert: '| col 1 | col 2 |\n| --- | --- |\n| a | b |\n' },
    { keyword: 'hr',     label: 'Divider',         hint: '---',                       insert: '---\n' },
    { keyword: 'link',   label: 'Link',            hint: '[text](url)',               insert: '[]()',          caretOffset: -3 },
    { keyword: 'image',  label: 'Image',           hint: '![alt](url)',               insert: '![]()',         caretOffset: -3 },
    { keyword: 'math',   label: 'Math (block)',    hint: '$$ expr $$',                insert: '$$\n\n$$\n',    caretOffset: -4 },
    { keyword: 'mermaid', label: 'Mermaid diagram', hint: '```mermaid',               insert: '```mermaid\ngraph LR\n  A --> B\n```\n' },
    { keyword: 'frontmatter', label: 'Frontmatter block', hint: '---\\ntitle: …\\n---', insert: '---\ntitle: \ntags: []\nstatus: draft\n---\n\n', caretOffset: -28 },
    { keyword: 'tag',    label: 'Tag (frontmatter helper)', hint: '`#tag`',           insert: '`#tag`' },
  ];

  let menuOpen = false;
  let triggerPos = -1; // position of the "/" that opened the menu
  let activeIdx = 0;
  let filtered: SlashCommand[] = [];

  function openMenuAt(pos: number) {
    triggerPos = pos;
    menuOpen = true;
    activeIdx = 0;
    updateMenu('');
    slashMenu.hidden = false;
  }

  function closeMenu() {
    menuOpen = false;
    slashMenu.hidden = true;
    triggerPos = -1;
  }

  function updateMenu(query: string) {
    const q = query.toLowerCase();
    filtered = COMMANDS.filter(
      (c) => !q || c.keyword.startsWith(q) || c.label.toLowerCase().includes(q),
    );
    if (filtered.length === 0) {
      slashMenu.innerHTML = '<div class="slash-empty">no commands match</div>';
      return;
    }
    activeIdx = Math.min(activeIdx, filtered.length - 1);
    slashMenu.innerHTML = filtered
      .map(
        (c, i) =>
          `<button type="button" class="slash-item ${i === activeIdx ? 'active' : ''}" data-idx="${i}">
             <span class="slash-key">/${c.keyword}</span>
             <span class="slash-label">${c.label}</span>
             <span class="slash-hint">${c.hint}</span>
           </button>`,
      )
      .join('');
    slashMenu.querySelectorAll('.slash-item').forEach((el) => {
      el.addEventListener('mousedown', (e) => {
        e.preventDefault();
        const idx = Number((el as HTMLElement).dataset.idx);
        select(idx);
      });
    });
  }

  function select(idx: number) {
    const cmd = filtered[idx];
    if (!cmd || triggerPos < 0) return;
    const val = textarea.value;
    // Range to replace: from triggerPos to the current caret end.
    const end = textarea.selectionStart;
    const before = val.slice(0, triggerPos);
    const after = val.slice(end);
    const insertText = cmd.insert;
    const newVal = before + insertText + after;
    textarea.value = newVal;
    const caretBase = before.length + insertText.length;
    const newCaret = caretBase + (cmd.caretOffset ?? 0);
    textarea.setSelectionRange(newCaret, newCaret);
    textarea.dispatchEvent(new Event('input'));
    closeMenu();
    textarea.focus();
  }

  const statusEl = document.getElementById('editor-status') as HTMLElement | null;
  const initialValue = textarea?.value ?? '';
  const setStatus = (state: 'clean' | 'dirty' | 'saving' | 'saved') => {
    if (!statusEl) return;
    statusEl.dataset.state = state;
    statusEl.textContent =
      state === 'dirty' ? 'Modified' :
      state === 'saving' ? 'Saving…' :
      state === 'saved' ? 'Saved' :
      'Saved';
  };

  // Toolbar — wrap selection with a prefix/suffix, prepend a prefix at line
  // start, insert a link/code-block scaffold. Reuses the textarea selection.
  const wrapSelection = (pre: string, post: string) => {
    if (!textarea) return;
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const sel = textarea.value.slice(start, end);
    const inserted = pre + (sel || 'text') + post;
    const before = textarea.value.slice(0, start);
    const after = textarea.value.slice(end);
    textarea.value = before + inserted + after;
    if (sel) {
      textarea.setSelectionRange(start + pre.length, start + pre.length + sel.length);
    } else {
      textarea.setSelectionRange(start + pre.length, start + pre.length + 4); // select 'text'
    }
    textarea.dispatchEvent(new Event('input'));
    textarea.focus();
  };
  const lineStartPrefix = (prefix: string) => {
    if (!textarea) return;
    const pos = textarea.selectionStart;
    const val = textarea.value;
    const lineStart = val.lastIndexOf('\n', pos - 1) + 1;
    textarea.value = val.slice(0, lineStart) + prefix + val.slice(lineStart);
    const newPos = pos + prefix.length;
    textarea.setSelectionRange(newPos, newPos);
    textarea.dispatchEvent(new Event('input'));
    textarea.focus();
  };
  const insertLink = () => {
    if (!textarea) return;
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const sel = textarea.value.slice(start, end) || 'text';
    const inserted = `[${sel}](url)`;
    const before = textarea.value.slice(0, start);
    const after = textarea.value.slice(end);
    textarea.value = before + inserted + after;
    const urlStart = before.length + sel.length + 3; // after `[sel](`
    textarea.setSelectionRange(urlStart, urlStart + 3); // select 'url'
    textarea.dispatchEvent(new Event('input'));
    textarea.focus();
  };
  const insertCodeBlock = () => {
    if (!textarea) return;
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const sel = textarea.value.slice(start, end);
    const block = '```\n' + (sel || '') + '\n```\n';
    const before = textarea.value.slice(0, start);
    const after = textarea.value.slice(end);
    textarea.value = before + block + after;
    const caret = sel ? before.length + block.length : before.length + 4; // after opening fence + newline
    textarea.setSelectionRange(caret, caret);
    textarea.dispatchEvent(new Event('input'));
    textarea.focus();
  };

  document.querySelectorAll<HTMLButtonElement>('.tb-btn').forEach((btn) => {
    btn.addEventListener('mousedown', (e) => {
      // mousedown so the textarea doesn't lose focus before we act.
      e.preventDefault();
    });
    btn.addEventListener('click', () => {
      const action = btn.dataset.action;
      if (action === 'wrap') {
        wrapSelection(btn.dataset.pre ?? '', btn.dataset.post ?? '');
      } else if (action === 'linestart') {
        lineStartPrefix(btn.dataset.prefix ?? '');
      } else if (action === 'link') {
        insertLink();
      } else if (action === 'codeblock') {
        insertCodeBlock();
      }
    });
  });

  if (textarea && preview && slashMenu) {
    const render = () => {
      preview.innerHTML = marked.parse(textarea.value) as string;
    };
    textarea.addEventListener('input', () => {
      // Mark dirty whenever the content diverges from the last saved value.
      if (statusEl) {
        setStatus(textarea.value === initialValue ? 'clean' : 'dirty');
      }
      render();
      // Update the in-progress filter if the menu is open.
      if (menuOpen) {
        const fragment = textarea.value.slice(triggerPos + 1, textarea.selectionStart);
        if (/[\s\n]/.test(fragment)) {
          closeMenu();
        } else {
          updateMenu(fragment);
        }
      }
    });

    textarea.addEventListener('keydown', (e) => {
      // Cmd/Ctrl+S → save
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 's') {
        e.preventDefault();
        setStatus('saving');
        const form = textarea.closest('form');
        if (form) form.requestSubmit();
        return;
      }
      // Cmd/Ctrl+B → bold
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'b') {
        e.preventDefault();
        wrapSelection('**', '**');
        return;
      }
      // Cmd/Ctrl+I → italic
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'i') {
        e.preventDefault();
        wrapSelection('*', '*');
        return;
      }
      // Cmd/Ctrl+K → link
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        insertLink();
        return;
      }

      if (menuOpen) {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          activeIdx = (activeIdx + 1) % filtered.length;
          updateMenu(textarea.value.slice(triggerPos + 1, textarea.selectionStart));
          return;
        }
        if (e.key === 'ArrowUp') {
          e.preventDefault();
          activeIdx = (activeIdx - 1 + filtered.length) % filtered.length;
          updateMenu(textarea.value.slice(triggerPos + 1, textarea.selectionStart));
          return;
        }
        if (e.key === 'Enter' || e.key === 'Tab') {
          e.preventDefault();
          select(activeIdx);
          return;
        }
        if (e.key === 'Escape') {
          e.preventDefault();
          closeMenu();
          return;
        }
      }

      // Open slash menu when "/" is typed at line start or after whitespace.
      if (e.key === '/') {
        const pos = textarea.selectionStart;
        const charBefore = pos > 0 ? textarea.value[pos - 1] : '\n';
        if (!charBefore || charBefore === '\n' || charBefore === ' ' || charBefore === '\t') {
          // Wait for the slash to actually be inserted, then open.
          setTimeout(() => openMenuAt(pos), 0);
        }
      }
    });

    textarea.addEventListener('blur', () => {
      // Brief delay so a mousedown on the menu still registers
      setTimeout(() => { if (menuOpen) closeMenu(); }, 100);
    });

    // Flag form submits as 'saving' so the indicator updates on Save click.
    const form = textarea.closest('form');
    if (form) {
      form.addEventListener('submit', () => setStatus('saving'));
    }

    render();
  }
</script>

<style is:global>
  .editor-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    min-height: 60vh;
  }
  .editor-pane {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .pane-label kbd {
    display: inline-block;
    padding: 0.05rem 0.4rem;
    font-family: ui-monospace, monospace;
    font-size: 0.72em;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    text-transform: none;
    letter-spacing: 0;
    color: var(--muted);
  }
  .editor-pane { position: relative; }

  /* ─── Slash command menu ─── */
  .slash-menu {
    position: absolute;
    z-index: 100;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    min-width: 320px;
    max-height: 260px;
    overflow-y: auto;
    padding: 0.4rem;
    bottom: 1rem;
    left: 1rem;
  }
  .slash-item {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.45rem 0.6rem;
    border: none;
    background: transparent;
    color: var(--text);
    border-radius: 6px;
    text-align: left;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
  }
  .slash-item.active,
  .slash-item:hover {
    background: var(--accent-bg);
    color: var(--accent);
  }
  .slash-key {
    font-family: ui-monospace, monospace;
    font-size: 0.78em;
    color: var(--muted);
  }
  .slash-item.active .slash-key { color: var(--accent); }
  .slash-label { font-weight: 500; }
  .slash-hint {
    font-family: ui-monospace, monospace;
    font-size: 0.72em;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 14rem;
  }
  .slash-empty {
    padding: 0.6rem 0.8rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-style: italic;
  }

  .pane-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
    font-weight: 700;
  }
  .pane-label-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .editor-status {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    padding: 0.1rem 0.5rem;
    border-radius: 99px;
    border: 1px solid transparent;
  }
  .editor-status[data-state='clean'],
  .editor-status[data-state='saved'] {
    color: var(--muted);
