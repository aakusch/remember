---
import Layout from '../../layouts/Layout.astro';
import { queryPages, listAttrs, type PageMeta } from '../../lib/api.ts';

const url = Astro.url;
const sp = url.searchParams;

// Read filter[<key>] pairs out of the query string.
const filter: Record<string, string> = {};
for (const [key, value] of sp.entries()) {
  const m = /^filter\[(.+)\]$/.exec(key);
  if (m && m[1] && value) filter[m[1]] = value;
}

const sort = sp.get('sort') ?? '';
const q = sp.get('q') ?? '';
const columnsParam = sp.get('columns') ?? 'path,title,tags,owner,status';
const columns = columnsParam.split(',').map((c) => c.trim()).filter(Boolean);
const limit = Math.max(1, Math.min(500, Number(sp.get('limit') ?? '100')));

const [result, attrs] = await Promise.all([
  queryPages({ filter, sort: sort || undefined, q: q || undefined, limit }),
  listAttrs(),
]);

// Built-in columns the user can pick from in addition to discovered frontmatter keys.
const systemColumns = ['path', 'title', 'modified', 'size', 'last_indexed'];
const availableColumns = Array.from(new Set([...systemColumns, ...attrs])).sort();

// Up to 4 filter rows in the form, prefilled from URL state.
const filterEntries = Object.entries(filter);
while (filterEntries.length < 4) filterEntries.push(['', '']);

function valueOf(page: PageMeta, key: string): string {
  if (key === 'path') return page.path;
  if (key === 'title') return page.title ?? '';
  if (key === 'modified') {
    if (!page.modified) return '';
    try { return new Date(page.modified).toLocaleString(); } catch { return page.modified; }
  }
  if (key === 'size') return String(page.size ?? '');
  if (key === 'last_indexed') {
    if (!page.last_indexed) return '';
    try { return new Date(page.last_indexed).toLocaleString(); } catch { return page.last_indexed; }
  }
  const fm = page.frontmatter ?? {};
  const v = (fm as Record<string, unknown>)[key];
  if (v === undefined || v === null) return '';
  if (Array.isArray(v)) return v.map(String).join(', ');
  if (typeof v === 'object') return JSON.stringify(v);
  return String(v);
}

function sortLabel(s: string): string {
  if (!s) return '(none)';
  if (s.startsWith('-')) return `${s.slice(1)} ↓`;
  return `${s} ↑`;
}
---
<Layout title="Views · Admin">
  <div class="main-col wide">
    <h1>Table view</h1>
    <p class="muted">
      Query your wiki by frontmatter — filter, sort, and pick columns. Built from the indexed <code>pages</code> table; reflects whatever's on disk at last index.
    </p>

    <form method="get" class="view-form">
      <div class="row">
        <label class="field">
          <span class="label">Free text</span>
          <input type="search" name="q" value={q} placeholder="title or path contains…" />
        </label>
        <label class="field">
          <span class="label">Sort</span>
          <select name="sort">
            <option value="" selected={!sort}>(default — path ↑)</option>
            {availableColumns.map((col) => (
              <>
                <option value={col} selected={sort === col}>{col} ↑</option>
                <option value={`-${col}`} selected={sort === `-${col}`}>{col} ↓</option>
              </>
            ))}
          </select>
        </label>
        <label class="field">
          <span class="label">Limit</span>
          <input type="number" name="limit" value={limit} min="1" max="500" />
        </label>
      </div>

      <div class="row" style="margin-top: 0.5rem;">
        <label class="field" style="flex: 1;">
          <span class="label">Columns (comma-separated; pick from available keys)</span>
          <input type="text" name="columns" value={columnsParam} list="attr-options" />
        </label>
      </div>

      <details style="margin-top: 0.5rem;">
        <summary class="muted" style="cursor: pointer; font-size: 0.85rem;">Available frontmatter keys ({attrs.length})</summary>
        <div class="chip-list" style="margin-top: 0.4rem;">
          {availableColumns.map((c) => <span class="chip"><code>{c}</code></span>)}
        </div>
      </details>

      <fieldset class="filter-block">
        <legend>Filters</legend>
        <p class="muted" style="margin: 0 0 0.5rem 0; font-size: 0.78rem;">
          Exact-match on scalar values, array-membership for list-valued frontmatter (e.g. <code>tags</code>). All filters AND together.
        </p>
        {filterEntries.map(([k, v], i) => (
          <div class="filter-row">
            <input type="text" name={`__filter_key_${i}`} value={k} placeholder="key (e.g. tags)" />
            <span class="op">=</span>
            <input type="text" name={`__filter_val_${i}`} value={v} placeholder="value (e.g. runbook)" />
          </div>
        ))}
      </fieldset>

      <div class="actions">
        <button type="submit" class="btn">Apply</button>
        <a href="/admin/views" class="btn secondary">Reset</a>
      </div>
    </form>

    {/*
      Filter inputs are paired as __filter_key_N / __filter_val_N so the form
      can carry multiple at once. A tiny client-side script rewrites them into
      filter[<key>]=<value> URL params on submit (because HTML forms can't
      synthesize the bracketed names from two paired inputs).
    */}
    <script is:inline>
      document.querySelector('.view-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const form = e.currentTarget;
        const fd = new FormData(form);
        const out = new URLSearchParams();
        for (const [name, value] of fd.entries()) {
          const km = /^__filter_key_(\d+)$/.exec(name);
          if (km) continue; // handled together with the value pair
          const vm = /^__filter_val_(\d+)$/.exec(name);
          if (vm) {
            const key = fd.get(`__filter_key_${vm[1]}`);
            if (typeof key === 'string' && key.trim() && typeof value === 'string' && value.trim()) {
              out.append(`filter[${key.trim()}]`, value.trim());
            }
            continue;
          }
          if (value) out.set(name, String(value));
        }
        window.location.search = '?' + out.toString();
      });
    </script>

    <div class="result-summary muted">
      {result.total} result{result.total === 1 ? '' : 's'}
      {Object.keys(filter).length > 0 && (
        <span> · filter: {Object.entries(filter).map(([k, v]) => <code style="margin-right: 0.3rem;">{k}={v}</code>)}</span>
      )}
      {sort && <span> · sort: <code>{sortLabel(sort)}</code></span>}
      {q && <span> · q: <code>{q}</code></span>}
    </div>

    {result.pages.length === 0 ? (
      <div class="alert" style="margin-top: 1rem;">No matching pages. Loosen filters or try a different query.</div>
    ) : (
      <div class="table-wrap">
        <table class="results">
          <thead>
            <tr>
              {columns.map((col) => (
                <th>
                  {col}
                  {/* Click header to toggle sort */}
                  <a
                    href={'?' + (() => {
                      const next = new URLSearchParams(url.searchParams);
                      if (sort === col) next.set('sort', `-${col}`);
                      else if (sort === `-${col}`) next.delete('sort');
                      else next.set('sort', col);
                      return next.toString();
                    })()}
                    class="sort-arrow"
                    title="Toggle sort"
                  >{sort === col ? '↑' : sort === `-${col}` ? '↓' : '⇅'}</a>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {result.pages.map((p) => (
              <tr>
                {columns.map((col, i) => (
                  <td>
                    {i === 0 ? (
                      <a href={`/${p.path.replace(/\.md$/, '')}`}>
                        {valueOf(p, col) || <span class="muted">—</span>}
                      </a>
                    ) : col === 'path' ? (
                      <code><a href={`/${p.path.replace(/\.md$/, '')}`}>{p.path}</a></code>
                    ) : (
                      valueOf(p, col) || <span class="muted">—</span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <p class="muted" style="font-size: 0.78rem; margin-top: 1rem;">
      Tip: bookmark the resulting URL to save a view. v1.x will add named saved views in <code>remember.config.ts</code>.
    </p>

    <h2 style="margin-top: 2.5rem;">Saved query presets</h2>
    <p class="muted">Common views — click to apply.</p>
    <div class="preset-grid">
      <a class="preset" href="/admin/views?filter[tags]=runbook&columns=path,title,severity,owner,status&sort=severity">
        <h4>Runbooks by severity</h4>
        <p>All pages tagged <code>runbook</code>, columns: path · title · severity · owner · status.</p>
      </a>
      <a class="preset" href="/admin/views?filter[tags]=adr&columns=path,title,status,date&sort=-date">
        <h4>ADRs newest first</h4>
        <p>Architecture decision records, sorted by date descending.</p>
      </a>
      <a class="preset" href="/admin/views?filter[owner]=platform&columns=path,title,tags,status&sort=path">
        <h4>Platform-owned</h4>
        <p>Everything owned by the platform team.</p>
      </a>
      <a class="preset" href="/admin/views?columns=path,title,tags,owner,modified&sort=-modified&limit=30">
        <h4>Recently modified</h4>
        <p>Latest 30 pages by modification time.</p>
      </a>
    </div>
  </div>
</Layout>

<style>
  .main-col.wide { max-width: 1280px; }
  .view-form {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    margin: 1rem 0;
  }
  .view-form .row { display: flex; gap: 1rem; flex-wrap: wrap; }
  .view-form .field { display: flex; flex-direction: column; gap: 0.3rem; flex: 1; min-width: 180px; }
  .view-form .label {
    font-size: 0.78rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }
  .view-form input, .view-form select {
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
  }
  .filter-block {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.85rem 1rem 1rem;
    margin: 1rem 0 0 0;
    background: var(--bg);
  }
  .filter-block legend {
    font-size: 0.78rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    padding: 0 0.5rem;
  }
  .filter-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }
  .filter-row input {
    flex: 1;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--card);
    color: var(--text);
    font: inherit;
    font-size: 0.88rem;
  }
  .filter-row .op { color: var(--muted); font-family: ui-monospace, monospace; }
  .actions { margin-top: 1rem; display: flex; gap: 0.5rem; }
  .chip-list { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .chip {
    padding: 0.18rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 99px;
    font-size: 0.78rem;
  }
  .result-summary { margin: 1.25rem 0 0.75rem 0; font-size: 0.88rem; }
  .table-wrap {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    overflow-x: auto;
    background: var(--card);
  }
  table.results {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  table.results th, table.results td {
    text-align: left;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  table.results th {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    background: var(--bg);
    font-weight: 600;
    white-space: nowrap;
  }
  table.results th .sort-arrow {
    color: var(--muted);
    text-decoration: none;
    margin-left: 0.4rem;
    font-size: 0.8rem;
  }
  table.results th .sort-arrow:hover { color: var(--accent); }
  table.results tbody tr:hover td { background: var(--bg); }
  table.results td code, table.results td a {
    color: var(--accent);
    text-decoration: none;
    word-break: break-all;
  }
  table.results td a:hover { text-decoration: underline; }
  table.results td:first-child { font-weight: 500; }

  .preset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.85rem;
    margin-top: 0.5rem;
  }
  .preset {
    display: block;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
    text-decoration: none;
    color: var(--text);
  }
  .preset:hover { border-color: var(--accent); }
  .preset h4 { margin: 0 0 0.3rem 0; font-size: 0.95rem; color: var(--accent); }
  .preset p { margin: 0; font-size: 0.8rem; color: var(--muted); }
</style>
