---
import Layout from '../../layouts/Layout.astro';
import { getConfig } from '../../lib/api.ts';

const config = await getConfig();
---
<Layout title="Settings · Admin">
  <div class="main-col">
    <h1>Settings</h1>
    <p class="muted">Your <code>remember.config.ts</code> as loaded by the running server.</p>

    {!config ? (
      <div class="alert error">Could not load config from the core API.</div>
    ) : (
      <>
        <div style="margin-top: 1.5rem;">
          <h3 style="margin-bottom: 0.25rem;">Identity</h3>
          <table>
            <tbody>
              <tr><td class="muted">Name</td><td>{config.config.name ?? <span class="muted">(not set)</span>}</td></tr>
              <tr><td class="muted">Description</td><td>{config.config.description ?? <span class="muted">(not set)</span>}</td></tr>
              <tr><td class="muted">Schema version</td><td>{config.config.schemaVersion}</td></tr>
            </tbody>
          </table>
        </div>

        <div style="margin-top: 2rem;">
          <h3 style="margin-bottom: 0.25rem;">Content</h3>
          <table>
            <tbody>
              <tr><td class="muted">Content directory</td><td><code>{config.config.content}</code></td></tr>
              <tr><td class="muted">Config root</td><td><code>{config.config_root}</code></td></tr>
              <tr><td class="muted">Config path</td><td>{config.config_path ? <code>{config.config_path}</code> : <span class="muted">(none — defaults)</span>}</td></tr>
            </tbody>
          </table>
        </div>

        <div style="margin-top: 2rem;">
          <h3 style="margin-bottom: 0.25rem;">Server</h3>
          <table>
            <tbody>
              <tr><td class="muted">Host</td><td><code>{config.config.server.host}</code></td></tr>
              <tr><td class="muted">API port</td><td><code>{config.config.server.apiPort}</code></td></tr>
              <tr><td class="muted">Viewer port</td><td><code>{config.config.server.port}</code></td></tr>
              <tr><td class="muted">Admin token</td><td>{config.config.server.adminToken ? <span class="badge">set</span> : <span class="muted">(not set — localhost only)</span>}</td></tr>
            </tbody>
          </table>
        </div>

        <div style="margin-top: 2rem;">
          <h3 style="margin-bottom: 0.25rem;">Viewer</h3>
          <table>
            <tbody>
              <tr><td class="muted">Landing page</td><td><code>{config.config.viewer.landing}</code></td></tr>
              <tr><td class="muted">Show admin</td><td>{config.config.viewer.showAdmin ? 'yes' : 'no'}</td></tr>
              <tr><td class="muted">Breadcrumbs</td><td>{config.config.viewer.breadcrumbs ? 'on' : 'off'}</td></tr>
            </tbody>
          </table>
        </div>

        <p class="muted" style="margin-top: 2.5rem;">
          <strong>Editing</strong>: edit <code>{config.config_path ?? 'remember.config.ts'}</code> in your editor, or use the <a href="/admin/setup">Setup wizard</a> to regenerate + save the config from the browser (writes via <code>PUT /v1/config</code>, then restart the core to apply).
        </p>
      </>
    )}
  </div>
</Layout>

<style>
  table { border-collapse: collapse; }
  td { padding: 0.4rem 1.5rem 0.4rem 0; font-size: 0.92rem; vertical-align: top; }
  h3 { font-size: 1rem; color: var(--accent); margin-top: 0; }
</style>
