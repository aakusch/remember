---
import Layout from '../../layouts/Layout.astro';
import { getStatus, triggerReindex } from '../../lib/api.ts';

let result: { ok: boolean; files_indexed?: number; chunks_added?: number; duration_ms?: number; error?: unknown } | null = null;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const mode = (form.get('mode') as 'incremental' | 'full' | null) ?? 'incremental';
    result = await triggerReindex(mode);
  } catch (err) {
    error = (err as Error).message;
  }
}

const status = await getStatus();
---
<Layout title="Reindex · Admin">
  <div class="main-col">
    <h1>Reindex</h1>
    <p class="muted">Rebuild the search index. Incremental skips unchanged files (sha256 match); full reindexes everything.</p>

    {error && <div class="alert error">{error}</div>}

    {result?.ok && (
      <div class="alert success">
        <strong>Index updated</strong> · {result.files_indexed} files / {result.chunks_added} chunks in {result.duration_ms}ms
      </div>
    )}
    {result && !result.ok && (
      <div class="alert error">Reindex failed: <pre>{JSON.stringify(result, null, 2)}</pre></div>
    )}

    <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
      <form method="post">
        <input type="hidden" name="mode" value="incremental" />
        <button type="submit" class="btn">Run incremental reindex</button>
      </form>
      <form method="post" onsubmit="return confirm('Run full reindex? This re-embeds every chunk and may take a while.')">
        <input type="hidden" name="mode" value="full" />
        <button type="submit" class="btn secondary">Run full reindex</button>
      </form>
    </div>

    {status && (
      <div style="margin-top: 2.5rem; padding: 1rem 1.25rem; background: var(--bg); border-radius: 6px;">
        <h3 style="margin-top: 0;">Current state</h3>
        <table>
          <tbody>
            <tr><td class="muted">State</td><td>{status.index.state}</td></tr>
            <tr><td class="muted">Pages indexed</td><td>{status.index.page_count}</td></tr>
            <tr><td class="muted">Chunks</td><td>{status.index.chunk_count}</td></tr>
            <tr><td class="muted">Embedder</td><td>{status.index.model}</td></tr>
            <tr><td class="muted">Dimension</td><td>{status.index.model_dim}</td></tr>
            <tr><td class="muted">API version</td><td>{status.version}</td></tr>
          </tbody>
        </table>
      </div>
    )}
  </div>
</Layout>

<style>
  table { border-collapse: collapse; }
  td { padding: 0.4rem 1rem 0.4rem 0; font-size: 0.92rem; }
</style>
