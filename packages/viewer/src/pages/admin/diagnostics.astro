---
import Layout from '../../layouts/Layout.astro';
import { getStatus, getConfig, API_BASE } from '../../lib/api.ts';

let healthOk = false;
let openapi: { paths?: Record<string, unknown> } | null = null;
let tools: { tools?: Array<{ name: string; description?: string }> } | null = null;

interface LogEntry {
  at: string;
  level: 'error' | 'warn' | 'info' | 'debug';
  source: string;
  message: string;
  detail?: Record<string, unknown>;
}
let logsPayload: { entries?: LogEntry[]; total?: number; note?: string } | null = null;

try {
  const h = await fetch(`${API_BASE}/health`);
  healthOk = h.ok;
} catch { /* fall through */ }

try {
  const o = await fetch(`${API_BASE}/openapi.json`);
  if (o.ok) openapi = await o.json();
} catch { /* fall through */ }

try {
  const t = await fetch(`${API_BASE}/tools`);
  if (t.ok) tools = await t.json();
} catch { /* fall through */ }

try {
  const l = await fetch(`${API_BASE}/logs?limit=50`);
  if (l.ok) logsPayload = await l.json();
} catch { /* fall through */ }

const [status, config] = await Promise.all([getStatus(), getConfig()]);

const logEntries = logsPayload?.entries ?? [];
const logCounts = logEntries.reduce(
  (acc, e) => {
    acc[e.level] = (acc[e.level] ?? 0) + 1;
    return acc;
  },
  {} as Record<string, number>,
);
const fmtTime = (iso: string) => {
  const d = new Date(iso);
  const now = Date.now();
  const delta = (now - d.getTime()) / 1000;
  if (delta < 60) return `${Math.floor(delta)}s ago`;
  if (delta < 3600) return `${Math.floor(delta / 60)}m ago`;
  if (delta < 86400) return `${Math.floor(delta / 3600)}h ago`;
  return d.toISOString().slice(0, 16).replace('T', ' ');
};
const levelColor = (l: string) => ({
  error: 'var(--danger)',
  warn: '#d97706',
  info: 'var(--muted)',
  debug: 'var(--muted)',
}[l] ?? 'var(--muted)');
---
<Layout title="Diagnostics · Admin">
  <div class="main-col">
    <h1>Diagnostics</h1>
    <p class="muted">Health checks for the core API and the indexing pipeline.</p>

    <div style="margin-top: 1.5rem;">
      <h3>API health</h3>
      <table>
        <tbody>
          <tr>
            <td class="muted">Endpoint</td>
            <td><code>{API_BASE}</code></td>
          </tr>
          <tr>
            <td class="muted">Status</td>
            <td>{healthOk ? <span class="badge" style="color: var(--success); border-color: var(--success);">healthy</span> : <span class="badge" style="color: var(--danger); border-color: var(--danger);">unreachable</span>}</td>
          </tr>
          <tr>
            <td class="muted">Version</td>
            <td>{status?.version ?? '—'}</td>
          </tr>
        </tbody>
      </table>
    </div>

    {status && (
      <div style="margin-top: 2rem;">
        <h3>Index</h3>
        <table>
          <tbody>
            <tr><td class="muted">State</td><td>{status.index.state}</td></tr>
            <tr><td class="muted">Pages</td><td>{status.index.page_count}</td></tr>
            <tr><td class="muted">Chunks</td><td>{status.index.chunk_count}</td></tr>
            <tr><td class="muted">Embedder model</td><td><code>{status.index.model}</code></td></tr>
            <tr><td class="muted">Embedding dimension</td><td>{status.index.model_dim}</td></tr>
          </tbody>
        </table>
      </div>
    )}

    <div class="diag-section">
      <div class="diag-section-header">
        <h3>Recent events <span class="muted count-tag">{logsPayload?.total ?? 0}</span></h3>
        <div class="level-counts">
          {(['error', 'warn', 'info'] as const).map((lvl) => (
            <span class="level-count" style={`color: ${levelColor(lvl)};`}>
              <strong>{logCounts[lvl] ?? 0}</strong> {lvl}
            </span>
          ))}
        </div>
        <button type="button" id="logs-refresh" class="btn secondary refresh-btn">Refresh</button>
      </div>
      {logEntries.length === 0 ? (
        <p class="muted empty-note">
          {logsPayload?.note ?? 'No events recorded yet — the buffer holds the last 50 errors, warnings, and lifecycle events.'}
        </p>
      ) : (
        <table class="logs-table">
          <thead>
            <tr>
              <th>When</th>
              <th>Level</th>
              <th>Source</th>
              <th>Message</th>
            </tr>
          </thead>
          <tbody>
            {logEntries.map((entry) => (
              <tr>
                <td class="log-time muted" title={entry.at}>{fmtTime(entry.at)}</td>
                <td>
                  <span class="log-level" style={`color: ${levelColor(entry.level)}; border-color: ${levelColor(entry.level)};`}>
                    {entry.level}
                  </span>
                </td>
                <td class="log-source muted">{entry.source}</td>
                <td class="log-message">{entry.message}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>

    {config && (
      <div style="margin-top: 2rem;">
        <h3>Config</h3>
        <table>
          <tbody>
            <tr><td class="muted">Config root</td><td><code>{config.config_root}</code></td></tr>
            <tr><td class="muted">Config path</td><td>{config.config_path ? <code>{config.config_path}</code> : <span class="muted">(none — defaults)</span>}</td></tr>
            <tr><td class="muted">Content dir</td><td><code>{config.config.content}</code></td></tr>
          </tbody>
        </table>
      </div>
    )}

    {openapi && (
      <div style="margin-top: 2rem;">
        <h3>API surface ({Object.keys(openapi.paths ?? {}).length} routes)</h3>
        <ul style="font-family: ui-monospace, monospace; font-size: 0.85rem;">
          {Object.entries(openapi.paths ?? {}).map(([p, methods]) => (
            <li>
              <code>/v1{p}</code>
              <span class="muted" style="margin-left: 0.5rem;">
                {Object.keys(methods as object).map((m) => m.toUpperCase()).join(', ')}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {tools?.tools && tools.tools.length > 0 && (
      <div style="margin-top: 2rem;">
        <h3>AI tool definitions ({tools.tools.length})</h3>
        <ul>
          {tools.tools.map((t) => (
            <li><code>{t.name}</code> — <span class="muted">{t.description}</span></li>
          ))}
        </ul>
        <p class="muted" style="font-size: 0.85rem;">
          These are returned by <code>GET {API_BASE}/tools</code> — drop them straight into a Claude or OpenAI tool-use call.
        </p>
      </div>
    )}
  </div>
</Layout>

<style>
  table { border-collapse: collapse; }
  td { padding: 0.4rem 1.5rem 0.4rem 0; font-size: 0.92rem; vertical-align: top; }
  h3 { font-size: 1rem; color: var(--accent); margin-top: 0; }
  ul { margin: 0.5rem 0; padding-left: 1.5rem; }
  li { margin: 0.25rem 0; }

  .diag-section { margin-top: 2rem; }
  .diag-section-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }
  .diag-section-header h3 { margin: 0; }
  .count-tag {
    font-weight: 400;
    font-size: 0.85rem;
    margin-left: 0.25rem;
  }
  .level-counts {
    display: flex;
    gap: 1rem;
    margin-left: auto;
    font-size: 0.8rem;
  }
  .level-count strong { font-weight: 600; }
  .refresh-btn {
    font-size: 0.78rem;
    padding: 0.2rem 0.7rem;
  }
  .empty-note { margin: 0.5rem 0; font-size: 0.9rem; }

  .logs-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }
  .logs-table th {
    text-align: left;
    padding: 0.5rem 0.85rem 0.5rem 0;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    font-weight: 600;
    border-bottom: 1px solid var(--border);
  }
  .logs-table td {
    padding: 0.5rem 0.85rem 0.5rem 0;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
  }
  .logs-table tr:last-child td { border-bottom: none; }
  .log-time { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; white-space: nowrap; min-width: 5rem; }
  .log-level {
    display: inline-block;
    padding: 0.05rem 0.5rem;
    border: 1px solid;
    border-radius: 99px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: transparent;
  }
  .log-source { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.78rem; }
  .log-message { color: var(--text); word-break: break-word; }
</style>

<script is:inline>
  // Logs refresh — re-fetches /v1/logs and reloads the list without a full
  // page reload.
  (() => {
    const btn = document.getElementById('logs-refresh');
    if (!btn) return;
    btn.addEventListener('click', () => {
      window.location.reload();
    });
  })();
</script>
