---
import Layout from '../layouts/Layout.astro';
import { getPage, getStatus, listPages, getConfig, API_BASE } from '../lib/api.ts';
import { marked } from 'marked';

const [config, landing, status, pages] = await Promise.all([
  getConfig(),
  getPage('README.md'),
  getStatus(),
  listPages().catch(() => ({ pages: [], total: 0 })),
]);

const landingPath = config?.config.viewer.landing ?? 'README.md';
const actualLanding = landingPath === 'README.md' ? landing : await getPage(landingPath);
const html = actualLanding ? marked.parse(actualLanding.body) : null;
const wikiName = config?.config.name ?? 'remember';
---
<Layout title={wikiName} currentPath="README.md">
  <div class="main-col">
    {actualLanding && html ? (
      <article set:html={html} />
    ) : (
      <article>
        <h1>{wikiName}</h1>
        <p class="muted">
          Could not load <code>{landingPath}</code> from <code>{API_BASE}</code>.
          Make sure the core API is running (<code>remember dev</code> or <code>remember start</code>).
        </p>
        {pages.pages.length > 0 ? (
          <>
            <h2>Pages</h2>
            <ul>
              {pages.pages.map((p) => (
                <li><a href={`/${p.path.replace(/\.md$/, '')}`}>{p.path}</a></li>
              ))}
            </ul>
          </>
        ) : (
          <p class="muted">No pages indexed yet. <a href="/admin/reindex">Run reindex →</a></p>
        )}
      </article>
    )}

    {status && (
      <p class="muted" style="margin-top: 1.5rem; text-align: center;">
        {status.index.page_count} pages · {status.index.chunk_count} chunks · {status.index.model} ({status.index.model_dim}-d)
      </p>
    )}
  </div>
</Layout>
