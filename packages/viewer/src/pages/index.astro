---
import Layout from '../layouts/Layout.astro';
import { getPage, getStatus, listPages, getConfig, API_BASE } from '../lib/api.ts';
import { marked } from 'marked';

const [config, landing, status, pages] = await Promise.all([
  getConfig(),
  getPage('README.md'),
  getStatus(),
  listPages().catch(() => ({ pages: [], total: 0 })),
]);

const landingPath = config?.config.viewer.landing ?? 'README.md';
const actualLanding = landingPath === 'README.md' ? landing : await getPage(landingPath);
const html = actualLanding ? marked.parse(actualLanding.body) : null;
const wikiName = config?.config.name ?? 'remember';
const isEmpty = !actualLanding && pages.pages.length === 0;
---
<Layout title={wikiName} currentPath="README.md">
  <div class="main-col">
    {actualLanding && html ? (
      <article set:html={html} />
    ) : isEmpty ? (
      <article class="empty-state">
        <div class="empty-icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
        </div>
        <h1>{wikiName}</h1>
        <p class="empty-lede">Your wiki is empty. Create your first page to get started.</p>
        <div class="empty-actions">
          <a class="btn" href="/admin/edit/getting-started">Create a page</a>
          <a class="btn secondary" href="/admin/setup">Configure</a>
        </div>
        <div class="empty-hints">
          <h3>Three ways to add content</h3>
          <ol>
            <li>Drop any <code>.md</code> file into your <code>content/</code> directory — the watcher auto-indexes it.</li>
            <li>Click <strong>Create a page</strong> above to open the browser editor.</li>
            <li>Configure a <a href="/admin/connectors">connector</a> (GitHub, Notion, Obsidian) to pull content in from elsewhere.</li>
          </ol>
        </div>
      </article>
    ) : (
      <article>
        <h1>{wikiName}</h1>
        <p class="muted">
          Could not load <code>{landingPath}</code> from <code>{API_BASE}</code>.
          Make sure the core API is running (<code>remember dev</code> or <code>remember start</code>).
        </p>
        {pages.pages.length > 0 && (
          <>
            <h2>Pages</h2>
            <ul>
              {pages.pages.map((p) => (
                <li><a href={`/${p.path.replace(/\.md$/, '')}`}>{p.path}</a></li>
              ))}
            </ul>
          </>
        )}
      </article>
    )}

    {status && !isEmpty && (
      <p class="muted index-stats">
        {status.index.page_count} pages · {status.index.chunk_count} chunks · {status.index.model} ({status.index.model_dim}-d)
      </p>
    )}
  </div>
</Layout>

<style>
  .index-stats {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.85rem;
  }
  .empty-state {
    text-align: center;
    padding: 3rem 2.5rem;
  }
  .empty-icon {
    color: var(--muted);
    margin-bottom: 1rem;
    opacity: 0.5;
  }
  .empty-state h1 {
    margin: 0 0 0.5rem 0;
    font-size: 1.75rem;
  }
  .empty-lede {
    color: var(--muted);
    margin: 0 auto 1.75rem auto;
    max-width: 32rem;
  }
  .empty-actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
  .empty-hints {
    text-align: left;
    max-width: 36rem;
    margin: 0 auto;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .empty-hints h3 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
    margin: 0 0 0.85rem 0;
    font-weight: 600;
  }
  .empty-hints ol {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.92rem;
    color: var(--text);
  }
  .empty-hints li { margin: 0.5rem 0; line-height: 1.55; }
  .empty-hints code {
    background: var(--bg);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-size: 0.85em;
    border: 1px solid var(--border);
  }
</style>
