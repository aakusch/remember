---
interface Props {
  title?: string;
}
const { title = 'remember' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light dark;
        --text: #111;
        --muted: #666;
        --accent: #2563eb;
        --bg: #fafafa;
        --card: #fff;
        --border: #e5e5e5;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --text: #f5f5f5;
          --muted: #999;
          --accent: #60a5fa;
          --bg: #0a0a0a;
          --card: #161616;
          --border: #2a2a2a;
        }
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--text);
        font: 16px/1.6 -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
      }
      header {
        padding: 1rem 2rem;
        border-bottom: 1px solid var(--border);
        background: var(--card);
        display: flex;
        align-items: center;
        gap: 2rem;
      }
      header a { color: var(--text); text-decoration: none; font-weight: 600; }
      header nav { display: flex; gap: 1.5rem; }
      header nav a { font-weight: 400; color: var(--muted); }
      header nav a:hover { color: var(--accent); }
      header form { margin-left: auto; }
      header input[type="search"] {
        font: inherit;
        padding: 0.4rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--bg);
        color: var(--text);
        width: 240px;
      }
      main {
        max-width: 820px;
        margin: 0 auto;
        padding: 2rem;
      }
      article { background: var(--card); padding: 2rem; border: 1px solid var(--border); border-radius: 8px; }
      article h1 { margin-top: 0; }
      article pre, article code { background: var(--bg); padding: 0.2rem 0.4rem; border-radius: 4px; font-family: ui-monospace, monospace; font-size: 0.9em; }
      article pre { padding: 1rem; overflow-x: auto; }
      .muted { color: var(--muted); font-size: 0.9rem; }
      footer { padding: 2rem; text-align: center; color: var(--muted); font-size: 0.85rem; }
    </style>
  </head>
  <body>
    <header>
      <a href="/">remember</a>
      <nav>
        <a href="/">Home</a>
        <a href="/search">Search</a>
      </nav>
      <form action="/search">
        <input type="search" name="q" placeholder="Search…" />
      </form>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      Powered by <a href="https://github.com/" style="color: var(--muted);">remember</a>
    </footer>
  </body>
</html>
