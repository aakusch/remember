---
import Sidebar from '../components/Sidebar.astro';
import { listPages } from '../lib/api.ts';
import { buildTree } from '../lib/tree.ts';

interface Props {
  title?: string;
  currentPath?: string;
  hideSidebar?: boolean;
}

const { title = 'remember', currentPath, hideSidebar = false } = Astro.props;

const pagesResult = await listPages().catch(() => ({ pages: [], total: 0 }));
const tree = buildTree(pagesResult.pages);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light dark;
        --text: #18181b;
        --muted: #71717a;
        --accent: #2563eb;
        --accent-bg: rgba(37, 99, 235, 0.08);
        --bg: #fafafa;
        --card: #fff;
        --border: #e4e4e7;
        --danger: #dc2626;
        --success: #16a34a;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --text: #f4f4f5;
          --muted: #a1a1aa;
          --accent: #60a5fa;
          --accent-bg: rgba(96, 165, 250, 0.12);
          --bg: #09090b;
          --card: #18181b;
          --border: #27272a;
          --danger: #f87171;
          --success: #4ade80;
        }
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--text);
        font: 15px/1.6 -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
      }

      header.top {
        height: 60px;
        padding: 0 1.5rem;
        border-bottom: 1px solid var(--border);
        background: var(--card);
        display: flex;
        align-items: center;
        gap: 1.5rem;
        position: sticky;
        top: 0;
        z-index: 10;
      }
      header.top a.brand {
        color: var(--text);
        text-decoration: none;
        font-weight: 700;
        font-size: 1.05rem;
      }
      header.top nav { display: flex; gap: 1.25rem; }
      header.top nav a {
        font-weight: 400;
        color: var(--muted);
        text-decoration: none;
        font-size: 0.92rem;
      }
      header.top nav a:hover { color: var(--accent); }
      header.top form { margin-left: auto; }
      header.top input[type="search"] {
        font: inherit;
        padding: 0.45rem 0.85rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--bg);
        color: var(--text);
        width: 280px;
        outline: none;
      }
      header.top input[type="search"]:focus {
        border-color: var(--accent);
      }

      .shell {
        display: flex;
        min-height: calc(100vh - 60px);
      }
      .main-col {
        flex: 1;
        min-width: 0;
        padding: 2rem 2.5rem;
        max-width: 980px;
        margin: 0 auto;
      }
      .main-col.with-toc {
        max-width: 1200px;
        display: flex;
        gap: 2rem;
        align-items: flex-start;
      }
      .main-col.with-toc > article {
        flex: 1;
        min-width: 0;
      }

      article {
        background: var(--card);
        padding: 2rem 2.5rem;
        border: 1px solid var(--border);
        border-radius: 8px;
      }
      article h1:first-child { margin-top: 0; }
      article h1, article h2, article h3 { line-height: 1.25; }
      article h1 { font-size: 1.85rem; }
      article h2 { font-size: 1.4rem; margin-top: 2rem; padding-bottom: 0.35rem; border-bottom: 1px solid var(--border); }
      article h3 { font-size: 1.15rem; margin-top: 1.5rem; }
      article code {
        background: var(--bg);
        padding: 0.15rem 0.35rem;
        border-radius: 4px;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.88em;
      }
      article pre {
        background: var(--bg);
        padding: 1rem 1.2rem;
        border-radius: 6px;
        overflow-x: auto;
        font-size: 0.88em;
        line-height: 1.55;
      }
      article pre code {
        background: transparent;
        padding: 0;
      }
      article a {
        color: var(--accent);
        text-decoration: none;
      }
      article a:hover { text-decoration: underline; }
      article table {
        border-collapse: collapse;
        margin: 1rem 0;
      }
      article th, article td {
        border: 1px solid var(--border);
        padding: 0.4rem 0.8rem;
      }
      article th { background: var(--bg); text-align: left; }
      article blockquote {
        border-left: 3px solid var(--border);
        padding: 0 1rem;
        margin: 1rem 0;
        color: var(--muted);
      }
      article ul, article ol { padding-left: 1.5rem; }

      .muted { color: var(--muted); font-size: 0.875rem; }
      .badge {
        display: inline-block;
        background: var(--bg);
        border: 1px solid var(--border);
        padding: 0.1rem 0.5rem;
        border-radius: 99px;
        font-size: 0.75rem;
        color: var(--muted);
      }
      .btn {
        display: inline-block;
        padding: 0.45rem 1rem;
        background: var(--accent);
        color: white;
        border: none;
        border-radius: 6px;
        font: inherit;
        cursor: pointer;
        text-decoration: none;
      }
      .btn:hover { opacity: 0.92; }
      .btn.secondary {
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
      }
      .btn.danger { background: var(--danger); }
      .alert {
        padding: 0.75rem 1rem;
        border-radius: 6px;
        margin: 1rem 0;
        border: 1px solid var(--border);
        background: var(--bg);
      }
      .alert.success { border-color: var(--success); color: var(--success); }
      .alert.error { border-color: var(--danger); color: var(--danger); }

      footer {
        padding: 1.5rem 2.5rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.8rem;
        border-top: 1px solid var(--border);
      }
    </style>
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/">remember</a>
      <nav>
        <a href="/">Home</a>
        <a href="/search">Search</a>
        <a href="/admin">Admin</a>
      </nav>
      <form action="/search">
        <input type="search" name="q" placeholder="Search the wiki…" />
      </form>
    </header>
    <div class="shell">
      {!hideSidebar && <Sidebar tree={tree} currentPath={currentPath} />}
      <slot />
    </div>
    <footer>
      <a href="https://github.com/" style="color: var(--muted);">remember</a> · v0.0.1
    </footer>
  </body>
</html>
