---
import Sidebar from '../components/Sidebar.astro';
import { listPages } from '../lib/api.ts';
import { buildTree } from '../lib/tree.ts';

interface Props {
  title?: string;
  currentPath?: string;
  hideSidebar?: boolean;
}

const { title = 'remember', currentPath, hideSidebar = false } = Astro.props;

const pagesResult = await listPages().catch(() => ({ pages: [], total: 0 }));
const tree = buildTree(pagesResult.pages);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: light dark;
        --text: #18181b;
        --muted: #71717a;
        --accent: #2563eb;
        --accent-bg: rgba(37, 99, 235, 0.08);
        --bg: #f4f4f5;
        --card: #ffffff;
        --border: #e4e4e7;
        --border-strong: #d4d4d8;
        --danger: #dc2626;
        --success: #16a34a;
        --shadow: 0 1px 3px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.06);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --text: #f4f4f5;
          --muted: #a1a1aa;
          --accent: #93c5fd;
          --accent-bg: rgba(147, 197, 253, 0.12);
          --bg: #0a0a0b;
          --card: #161618;
          --border: #2a2a2e;
          --border-strong: #3f3f46;
          --danger: #f87171;
          --success: #4ade80;
          --shadow: 0 1px 3px rgba(0, 0, 0, 0.4), 0 1px 2px rgba(0, 0, 0, 0.3);
        }
      }
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--text);
        font: 15px/1.65 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      /* ─── Top header ─── */
      header.top {
        height: 64px;
        padding: 0 1.75rem;
        border-bottom: 1px solid var(--border);
        background: var(--card);
        display: flex;
        align-items: center;
        gap: 1.75rem;
        position: sticky;
        top: 0;
        z-index: 10;
      }
      header.top a.brand {
        color: var(--text);
        text-decoration: none;
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: -0.01em;
      }
      header.top nav.primary { display: flex; gap: 1.5rem; }
      header.top nav.primary a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.925rem;
        transition: color 0.15s;
      }
      header.top nav.primary a:hover { color: var(--text); }
      header.top form { margin-left: auto; }
      header.top input[type="search"] {
        font: inherit;
        padding: 0.5rem 0.95rem;
        border: 1px solid var(--border);
        border-radius: 7px;
        background: var(--bg);
        color: var(--text);
        width: 300px;
        outline: none;
        transition: border-color 0.15s, background 0.15s;
      }
      header.top input[type="search"]:focus {
        border-color: var(--accent);
        background: var(--card);
      }

      /* ─── App shell (sidebar + main) ─── */
      .shell {
        display: flex;
        min-height: calc(100vh - 64px);
        align-items: stretch;
      }
      .main-wrap {
        flex: 1;
        min-width: 0;
        display: flex;
        justify-content: center;
        padding: 2.5rem 2rem;
      }
      .main-col {
        width: 100%;
        max-width: 820px;
      }
      .main-col.with-toc {
        max-width: 1180px;
        display: flex;
        gap: 3rem;
        align-items: flex-start;
      }
      .main-col.with-toc > article {
        flex: 1;
        min-width: 0;
      }

      /* ─── Article card ─── */
      article {
        background: var(--card);
        padding: 2.5rem 2.75rem;
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: var(--shadow);
      }
      article > :first-child { margin-top: 0; }
      article > :last-child { margin-bottom: 0; }

      article h1, article h2, article h3, article h4 {
        line-height: 1.25;
        font-weight: 650;
        letter-spacing: -0.01em;
      }
      article h1 { font-size: 1.95rem; margin: 0 0 1rem 0; }
      article h2 {
        font-size: 1.4rem;
        margin: 2.25rem 0 0.9rem 0;
        padding-bottom: 0.45rem;
        border-bottom: 1px solid var(--border);
      }
      article h3 { font-size: 1.15rem; margin: 1.75rem 0 0.6rem 0; }
      article h4 { font-size: 1rem; margin: 1.5rem 0 0.5rem 0; }
      article p { margin: 0.85rem 0; }
      article code {
        background: var(--bg);
        padding: 0.12rem 0.4rem;
        border-radius: 4px;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.875em;
        border: 1px solid var(--border);
      }
      article pre {
        background: var(--bg);
        padding: 1rem 1.25rem;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 0.88em;
        line-height: 1.55;
        border: 1px solid var(--border);
        margin: 1rem 0;
      }
      article pre code {
        background: transparent;
        padding: 0;
        border: none;
        font-size: 1em;
      }
      article a {
        color: var(--accent);
        text-decoration: none;
      }
      article a:hover { text-decoration: underline; }
      article table {
        border-collapse: collapse;
        margin: 1rem 0;
        width: 100%;
      }
      article th, article td {
        border: 1px solid var(--border);
        padding: 0.5rem 0.9rem;
        text-align: left;
      }
      article th { background: var(--bg); font-weight: 600; }
      article blockquote {
        border-left: 3px solid var(--border-strong);
        padding: 0.3rem 1.1rem;
        margin: 1rem 0;
        color: var(--muted);
      }
      article ul, article ol {
        padding-left: 1.5rem;
        margin: 0.85rem 0;
      }
      article li { margin: 0.25rem 0; }
      article hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2rem 0;
      }
      article strong { font-weight: 650; }

      /* ─── Headings on non-article pages ─── */
      .main-col > h1 {
        font-size: 1.95rem;
        font-weight: 650;
        letter-spacing: -0.01em;
        margin: 0 0 0.5rem 0;
      }
      .main-col > h2 {
        font-size: 1.3rem;
        font-weight: 650;
        letter-spacing: -0.01em;
        margin: 2rem 0 0.75rem 0;
      }

      /* ─── Utility classes ─── */
      .muted { color: var(--muted); font-size: 0.875rem; }
      .badge {
        display: inline-block;
        background: var(--bg);
        border: 1px solid var(--border);
        padding: 0.15rem 0.55rem;
        border-radius: 99px;
        font-size: 0.75rem;
        color: var(--muted);
        font-weight: 500;
      }

      /* ─── Buttons ─── */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1.1rem;
        background: var(--accent);
        color: white;
        border: 1px solid transparent;
        border-radius: 7px;
        font: inherit;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        transition: opacity 0.15s, background 0.15s;
      }
      .btn:hover { opacity: 0.92; text-decoration: none; }
      .btn.secondary {
        background: var(--card);
        color: var(--text);
        border-color: var(--border-strong);
      }
      .btn.secondary:hover { background: var(--bg); }
      .btn.danger { background: var(--danger); }

      input[type="text"], input[type="search"] {
        font: inherit;
      }

      .alert {
        padding: 0.85rem 1.1rem;
        border-radius: 8px;
        margin: 1rem 0;
        border: 1px solid var(--border);
        background: var(--card);
        font-size: 0.92rem;
      }
      .alert.success {
        border-color: rgba(22, 163, 74, 0.4);
        background: rgba(22, 163, 74, 0.06);
        color: var(--success);
      }
      .alert.error {
        border-color: rgba(220, 38, 38, 0.4);
        background: rgba(220, 38, 38, 0.06);
        color: var(--danger);
      }

      /* ─── Tab bar (multi-page nav) ─── */
      nav.tab-bar {
        position: sticky;
        top: 64px;
        z-index: 9;
        background: var(--card);
        border-bottom: 1px solid var(--border);
        padding: 0.35rem 0.85rem;
        display: flex;
        gap: 0.3rem;
        overflow-x: auto;
        scrollbar-width: thin;
      }
      nav.tab-bar .tab {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.3rem 0.55rem 0.3rem 0.7rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--bg);
        color: var(--muted);
        text-decoration: none;
        font-size: 0.8rem;
        white-space: nowrap;
        max-width: 22rem;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: color 0.12s, border-color 0.12s, background 0.12s;
      }
      nav.tab-bar .tab:hover { color: var(--text); border-color: var(--border-strong); }
      nav.tab-bar .tab.active {
        color: var(--accent);
        border-color: var(--accent);
        background: var(--accent-bg);
        font-weight: 500;
      }
      nav.tab-bar .tab-close {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        border-radius: 4px;
        font-size: 0.85rem;
        line-height: 1;
        color: var(--muted);
        cursor: pointer;
      }
      nav.tab-bar .tab-close:hover { background: var(--border-strong); color: var(--text); }
      nav.tab-bar .clear-tabs {
        margin-left: auto;
        padding: 0.3rem 0.6rem;
        border: 1px solid transparent;
        border-radius: 6px;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 0.78rem;
        cursor: pointer;
      }
      nav.tab-bar .clear-tabs:hover { color: var(--text); border-color: var(--border); }

      footer.site {
        padding: 1.5rem 2rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.8rem;
        border-top: 1px solid var(--border);
      }
      footer.site a { color: var(--muted); }
      .sse-status {
        display: inline-block;
        margin-left: 0.5rem;
        font-size: 0.7rem;
        color: var(--muted);
      }
      .sse-status[data-state="connected"] { color: var(--success); }
      .sse-status[data-state="disconnected"], .sse-status[data-state="error"] { color: var(--danger); }

      a.edit-link {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.82rem;
        padding: 0.1rem 0.5rem;
        border: 1px solid var(--border);
        border-radius: 99px;
        transition: color 0.12s, border-color 0.12s;
      }
      a.edit-link:hover {
        color: var(--accent);
        border-color: var(--accent);
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/">remember</a>
      <nav class="primary">
        <a href="/">Home</a>
        <a href="/search">Search</a>
        <a href="/admin">Admin</a>
      </nav>
      <form action="/search">
        <input type="search" name="q" placeholder="Search the wiki…" />
      </form>
    </header>
    <nav id="tab-bar" class="tab-bar" hidden></nav>
    <div class="shell">
      {!hideSidebar && <Sidebar tree={tree} currentPath={currentPath} />}
      <div class="main-wrap">
        <slot />
      </div>
    </div>
    <footer class="site">
      <a href="https://github.com/">remember</a> · v0.0.1 · <span id="sse-status" class="sse-status">●</span>
    </footer>

    <script is:inline define:vars={{ apiBase: import.meta.env.REMEMBER_API ?? 'http://127.0.0.1:4320/v1' }}>
      // SSE live-reload — listens for page.changed / index.completed and reloads
      // when the change touches the current page. Idempotent on multiple includes.
      (() => {
        if (window.__rememberSSE) return;
        window.__rememberSSE = true;
        const status = document.getElementById('sse-status');
        const setStatus = (state, title) => {
          if (!status) return;
          status.dataset.state = state;
          status.title = title;
        };
        const currentSlug = window.location.pathname.replace(/^\/+|\/+$/g, '');
        const matchesCurrent = (changedPath) => {
          if (!changedPath) return false;
          const a = changedPath.replace(/\.md$/, '').replace(/^\/+|\/+$/g, '');
          return a === currentSlug || a === 'README';
        };

        let reloadTimer = null;
        const scheduleReload = () => {
          if (reloadTimer) return;
          reloadTimer = setTimeout(() => window.location.reload(), 600);
        };

        const connect = () => {
          let es;
          try {
            es = new EventSource(`${apiBase}/events`);
          } catch {
            setStatus('error', 'SSE unsupported');
            return;
          }

          es.addEventListener('connected', () => setStatus('connected', 'live-reload connected'));
          es.addEventListener('heartbeat', () => {});
          es.addEventListener('page.changed', (e) => {
            try {
              const d = JSON.parse(e.data);
              if (matchesCurrent(d.path)) scheduleReload();
              if (window.location.pathname === '/' || window.location.pathname === '') scheduleReload();
            } catch {}
          });
          es.addEventListener('page.saved', (e) => {
            try {
              const d = JSON.parse(e.data);
              if (matchesCurrent(d.path)) scheduleReload();
            } catch {}
          });
          es.addEventListener('index.completed', () => {
            // Refresh listing pages so the sidebar tree updates.
            if (window.location.pathname.startsWith('/admin/files')) scheduleReload();
          });
          es.onerror = () => {
            setStatus('disconnected', 'live-reload disconnected — retrying');
            es.close();
            setTimeout(connect, 3000);
          };
        };

        connect();
      })();
    </script>

    <script is:inline>
      // Multi-tab bar — tracks recently opened pages in localStorage, renders
      // a tab strip the user can switch between. Admin pages are excluded.
      (() => {
        if (window.__rememberTabs) return;
        window.__rememberTabs = true;

        const KEY = 'remember-tabs-v1';
        const MAX = 12;
        const bar = document.getElementById('tab-bar');
        if (!bar) return;

        const isContentPage = (path) => {
          if (!path) return false;
          if (path === '/' || path === '') return true;
          return !path.startsWith('/admin') && !path.startsWith('/api') && !path.startsWith('/search');
        };

        const load = () => {
          try {
            const raw = localStorage.getItem(KEY);
            return raw ? JSON.parse(raw) : [];
          } catch { return []; }
        };
        const save = (tabs) => {
          try { localStorage.setItem(KEY, JSON.stringify(tabs)); } catch {}
        };

        const docTitle = (() => {
          const t = document.title.replace(/\s*·\s*remember\s*$/, '').replace(/\s*·\s*Admin\s*$/, '');
          return t || (location.pathname === '/' ? 'Home' : location.pathname);
        })();

        let tabs = load();
        const currentPath = location.pathname;

        if (isContentPage(currentPath)) {
          // Bump current to the right; reuse existing entry if present (preserve title from prior visit).
          const existingIdx = tabs.findIndex((t) => t.path === currentPath);
          if (existingIdx >= 0) tabs.splice(existingIdx, 1);
          tabs.push({ path: currentPath, title: docTitle, opened_at: Date.now() });
          // Cap at MAX, dropping the oldest.
          while (tabs.length > MAX) tabs.shift();
          save(tabs);
        }

        const render = () => {
          if (tabs.length === 0) {
            bar.hidden = true;
            bar.innerHTML = '';
            return;
          }
          bar.hidden = false;
          bar.innerHTML = tabs.map((t) => {
            const isActive = t.path === currentPath;
            const safeTitle = (t.title || t.path).replace(/[<>&"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' })[c]);
            return `
              <a class="tab ${isActive ? 'active' : ''}" href="${t.path}">
                <span>${safeTitle}</span>
                <span class="tab-close" data-close="${t.path}" title="Close tab">×</span>
              </a>
            `;
          }).join('') + `<button type="button" class="clear-tabs" title="Close all tabs">Clear</button>`;

          bar.querySelectorAll('.tab-close').forEach((el) => {
            el.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              const path = el.getAttribute('data-close');
              tabs = tabs.filter((t) => t.path !== path);
              save(tabs);
              render();
            });
          });
          const clearBtn = bar.querySelector('.clear-tabs');
          if (clearBtn) {
            clearBtn.addEventListener('click', () => {
              tabs = [];
              save(tabs);
              render();
            });
          }
        };

        render();
      })();
    </script>
  </body>
</html>
