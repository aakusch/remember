---
import type { TreeNode } from '../lib/tree.ts';
import TreeItem from './TreeItem.astro';

interface Props {
  tree: TreeNode[];
  currentPath?: string;
}

const { tree, currentPath } = Astro.props;
---
<aside id="wiki-sidebar" class="sidebar" data-collapsed="false">
  <div class="sidebar-header">
    <span class="sidebar-title">Pages</span>
    <button
      type="button"
      class="sidebar-collapse"
      data-toggle="wiki-sidebar"
      title="Collapse / expand page tree"
      aria-label="Collapse page tree"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline class="chev-collapsed" points="13 17 18 12 13 7" style="display:none;"/>
        <polyline class="chev-expanded" points="15 18 9 12 15 6"/>
      </svg>
    </button>
  </div>
  {tree.length === 0 ? (
    <p class="sidebar-empty">No pages yet.<br /><a href="/admin/reindex">Run a reindex →</a></p>
  ) : (
    <nav>
      <ul class="tree">
        {tree.map((node) => <TreeItem node={node} currentPath={currentPath} />)}
      </ul>
    </nav>
  )}
</aside>

<style is:global>
  .sidebar {
    width: 264px;
    flex-shrink: 0;
    padding: 1.25rem 1rem 1.5rem 1.1rem;
    border-right: 1px solid var(--border);
    background: var(--card);
    overflow-y: auto;
    overflow-x: hidden;
    max-height: calc(100vh - 64px);
    position: sticky;
    top: 64px;
    transition: width 0.18s ease, padding 0.18s ease;
  }
  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 0.6rem 0.4rem;
    padding-right: 0.2rem;
  }
  .sidebar-title {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
    font-weight: 700;
  }
  .sidebar-collapse {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--muted);
    border-radius: 5px;
    cursor: pointer;
    transition: color 0.12s, background 0.12s;
  }
  .sidebar-collapse:hover {
    color: var(--text);
    background: var(--bg);
  }
  .sidebar-empty {
    color: var(--muted);
    font-size: 0.875rem;
    padding: 0 0.5rem;
    line-height: 1.5;
  }
  .sidebar-empty a {
    color: var(--accent);
    text-decoration: none;
  }

  /* Page tree */
  .tree, .tree ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tree ul {
    padding-left: 0.85rem;
    margin-left: 0.45rem;
    border-left: 1px solid var(--border);
  }
  .tree li {
    margin: 0;
  }
  .tree a, .tree summary.folder-summary {
    display: block;
    padding: 0.3rem 0.6rem;
    text-decoration: none;
    color: var(--text);
    border-radius: 5px;
    font-size: 0.9rem;
    line-height: 1.4;
    cursor: pointer;
  }
  .tree a:hover {
    background: var(--bg);
    color: var(--accent);
  }
  .tree a.active {
    background: var(--accent-bg);
    color: var(--accent);
    font-weight: 600;
  }
  .tree summary.folder-summary {
    color: var(--muted);
    font-weight: 500;
    list-style: none;
    user-select: none;
  }
  .tree summary.folder-summary:hover {
    background: var(--bg);
    color: var(--text);
  }
  .tree summary.folder-summary::-webkit-details-marker { display: none; }
  .tree summary.folder-summary::before {
    content: '▸';
    display: inline-block;
    width: 0.9em;
    margin-right: 0.25rem;
    transition: transform 0.12s;
    font-size: 0.75em;
    color: var(--muted);
  }
  .tree details[open] > summary.folder-summary::before {
    transform: rotate(90deg);
  }

  /* Collapsed sidebar — narrow expand-only strip */
  .sidebar[data-collapsed="true"] {
    width: 36px;
    padding: 1.25rem 0.35rem 1.25rem 0.35rem;
  }
  .sidebar[data-collapsed="true"] .sidebar-header {
    margin: 0;
    justify-content: center;
  }
  .sidebar[data-collapsed="true"] .sidebar-title { display: none; }
  .sidebar[data-collapsed="true"] nav,
  .sidebar[data-collapsed="true"] .sidebar-empty { display: none; }
  .sidebar[data-collapsed="true"] .sidebar-collapse .chev-collapsed { display: inline !important; }
  .sidebar[data-collapsed="true"] .sidebar-collapse .chev-expanded { display: none; }
</style>
