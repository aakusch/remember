---
interface Props {
  crumbs: Array<{ name: string; path: string }>;
}

const { crumbs } = Astro.props;
---
{crumbs.length > 0 && (
  <nav class="crumbs" aria-label="Breadcrumbs">
    <a href="/">Home</a>
    {crumbs.map((c, i) => (
      <>
        <span class="sep">/</span>
        {i === crumbs.length - 1 ? (
          <span class="current">{c.name}</span>
        ) : (
          <a href={'/' + c.path}>{c.name}</a>
        )}
      </>
    ))}
  </nav>
)}

<style is:global>
  nav.crumbs {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }
  nav.crumbs a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.12s;
  }
  nav.crumbs a:hover { color: var(--accent); }
  nav.crumbs .sep { color: var(--border-strong); }
  nav.crumbs .current { color: var(--text); font-weight: 500; }
</style>
