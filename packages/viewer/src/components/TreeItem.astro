---
import type { TreeNode } from '../lib/tree.ts';
import TreeItem from './TreeItem.astro';

interface Props {
  node: TreeNode;
  currentPath?: string;
}

const { node, currentPath } = Astro.props;

const isActive =
  node.isFile &&
  (currentPath === node.path || currentPath === node.path.replace(/\.md$/, ''));
const href = node.isFile ? '/' + node.path.replace(/\.md$/, '') : '';
const display = node.isFile ? node.name.replace(/\.md$/, '') : node.name;
---
<li>
  {node.isFile ? (
    <a href={href} class={isActive ? 'active' : ''}>{display}</a>
  ) : (
    <details open>
      <summary class="folder-summary">{display}</summary>
      {node.children && node.children.length > 0 && (
        <ul>
          {node.children.map((child) => (
            <TreeItem node={child} currentPath={currentPath} />
          ))}
        </ul>
      )}
    </details>
  )}
</li>
